{
  "name": "3dmapmaker-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "3DMapMaker Next - browser-only authored 3D map / world builder",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run dev -w @3dmm/web",
    "build": "npm run build -w @3dmm/web",
    "preview": "npm run preview -w @3dmm/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "e2e": "playwright test",
    "qa": "node scripts/run-qa.mjs",
    "bench": "node scripts/run-bench.mjs",
    "rust:build": "node scripts/build-rust.mjs",
    "rust:test": "node scripts/build-rust.mjs --test",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/earcut": "^2.1.4",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "earcut": "^3.0.1",
    "geotiff": "^2.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "three": "^0.171.0",
    "three-mesh-bvh": "^0.8.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  }
}
